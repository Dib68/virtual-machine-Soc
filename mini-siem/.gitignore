# ── Secrets — NEVER commit these ──────────────────────────────
.env
*.key
*.pem
*.crt
secrets/

# ── Generated files (keep placeholder, ignore content) ────────
reports/*.md
reports/*.html
reports/*.json
# threat-intel.rules is auto-generated by make threat-intel
# The placeholder is committed; the populated version is gitignored after first run
# Uncomment the line below after running: make threat-intel
# config/suricata/rules/threat-intel.rules

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# ── Docker volumes / data ─────────────────────────────────────
data/

# ── macOS / Windows ───────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
