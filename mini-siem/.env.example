# Mini-SIEM Lab — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────
# .env is in .gitignore — never commit secrets to git

# ── Elasticsearch ──────────────────────────────────────────────
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
# Memory allocation (adjust to 50% of available RAM)
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ── Kibana ─────────────────────────────────────────────────────
KIBANA_URL=http://localhost:5601
KIBANA_USERNAME=
KIBANA_PASSWORD=

# ── Logstash ───────────────────────────────────────────────────
LS_JAVA_OPTS=-Xms512m -Xmx512m

# ── TheHive (SOAR integration) ────────────────────────────────
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=your_api_key_here
THEHIVE_ORG=mini-siem-lab

# ── Threat Intelligence APIs (optional — free tier available) ──
# AbuseIPDB: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=

# ── Target machine (lab attack target) ────────────────────────
TARGET_IP=172.20.0.10
TARGET_SSH_PORT=2222
TARGET_HTTP_PORT=8080
TARGET_SSH_USER=labuser
TARGET_SSH_PASS=labpass

# ── Report settings ────────────────────────────────────────────
REPORT_DAYS=7
REPORT_OUTPUT_DIR=./reports
ANALYST_NAME=Damiano Di Biase
